{
  "domain": "pioneer_telnet_avr",
  "name": "Pioneer Telnet AVR",
  "codeowners": [],
  "config_flow": true,
  "dependencies": [
    "zeroconf",
    "homekit"
  ],
  "documentation": "https://github.com/holuspokus/pioneer-telnet-avr",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/holuspokus/pioneer-telnet-avr/issues",
  "requirements": [
    "PyQRCode==1.2.1",
    "pypng==0.20220715.0"
  ],
  "version": "0.1.56",
  "zeroconf": [
    {
      "type": "_raop._tcp.local.",
      "properties": {
        "am": "vsx*"
      }
    },
    {
      "type": "_raop._tcp.local.",
      "name": "*@vsx-*"
    }
  ]
}
